# Both values are required to enable Supabase. Without them, localhost uses demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only recommendation statistics and seed script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Gemini API key for AI review summary and wishlist advice. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
